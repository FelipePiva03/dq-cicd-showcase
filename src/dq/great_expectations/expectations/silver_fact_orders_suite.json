{
  "name": "silver_fact_orders_suite",
  "meta": {
    "comment": "Business-rule gate for silver.fact_orders. Runs AFTER quarantine pre-MERGE, so structural integrity (null PK, null FK, unparseable timestamps) is already filtered. These rules protect downstream gold mart assumptions."
  },
  "expectations": [
    {
      "type": "ExpectColumnValuesToBeUnique",
      "kwargs": { "column": "order_id" },
      "meta": { "severity": "critical", "rationale": "duplicate order_id would double-count revenue in gold marts" }
    },
    {
      "type": "ExpectColumnValuesToBeInSet",
      "kwargs": {
        "column": "order_status",
        "value_set": ["delivered", "shipped", "canceled", "unavailable", "invoiced", "processing", "created", "approved"]
      },
      "meta": { "severity": "critical", "rationale": "unknown status breaks gold delivery_performance filters" }
    },
    {
      "type": "ExpectColumnValuesToBeBetween",
      "kwargs": {
        "column": "days_to_delivery",
        "min_value": 0,
        "max_value": 90,
        "mostly": 0.99
      },
      "meta": { "severity": "warning", "rationale": "stat anomaly — 1% tail tolerated (mostly skips nulls); doesn't break gold" }
    },
    {
      "type": "ExpectColumnPairValuesAToBeGreaterThanB",
      "kwargs": {
        "column_A": "order_delivered_customer_date",
        "column_B": "order_purchase_timestamp",
        "or_equal": true,
        "ignore_row_if": "either_value_is_missing"
      },
      "meta": { "severity": "warning", "rationale": "negative delivery time is suspicious but rare; quarantine catches the structural case" }
    },
    {
      "type": "ExpectColumnPairValuesAToBeGreaterThanB",
      "kwargs": {
        "column_A": "order_approved_at",
        "column_B": "order_purchase_timestamp",
        "or_equal": true,
        "ignore_row_if": "either_value_is_missing"
      },
      "meta": { "severity": "warning", "rationale": "approved-before-purchase is impossible by definition; if seen, it's source corruption" }
    },
    {
      "type": "ExpectTableRowCountToBeBetween",
      "kwargs": { "min_value": 1, "max_value": 10000000 },
      "meta": { "severity": "critical", "rationale": "empty silver means upstream pipeline broke" }
    }
  ]
}
