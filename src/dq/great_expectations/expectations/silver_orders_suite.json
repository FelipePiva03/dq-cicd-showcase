{
  "expectation_suite_name": "silver_orders_suite",
  "meta": {
    "comment": "Fair comparison reference: these checks mirror exactly the Soda checks in dq/soda/checks/silver_orders_checks.yml — same business rules, different tools."
  },
  "expectations": [
    {
      "expectation_type": "expect_column_values_to_not_be_null",
      "kwargs": { "column": "order_id" }
    },
    {
      "expectation_type": "expect_column_values_to_be_unique",
      "kwargs": { "column": "order_id" }
    },
    {
      "expectation_type": "expect_column_values_to_not_be_null",
      "kwargs": { "column": "customer_id" }
    },
    {
      "expectation_type": "expect_column_values_to_be_in_set",
      "kwargs": {
        "column": "order_status",
        "value_set": ["delivered", "shipped", "canceled", "unavailable", "invoiced", "processing", "created", "approved"]
      }
    },
    {
      "expectation_type": "expect_column_values_to_be_between",
      "kwargs": { "column": "days_to_delivery", "min_value": 0, "max_value": 90, "mostly": 0.99 }
    },
    {
      "expectation_type": "expect_column_pair_values_a_to_be_greater_than_b",
      "kwargs": {
        "column_A": "order_delivered_customer_date",
        "column_B": "order_purchase_timestamp",
        "or_equal": true,
        "ignore_row_if": "either_value_is_missing"
      }
    },
    {
      "expectation_type": "expect_table_row_count_to_be_between",
      "kwargs": { "min_value": 1, "max_value": 1000000 }
    }
  ]
}
